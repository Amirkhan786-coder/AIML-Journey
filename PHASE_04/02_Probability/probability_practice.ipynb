   "source": [
    "from scipy.stats import binom, norm, poisson\n",
    "\n",
    "# Binomial distribution\n",
    "print(\"Binomial:\", binom.pmf(2, 3, 0.5))\n",
    "\n",
    "# Normal distribution\n",
    "print(\"Normal:\", norm.pdf(0, loc=0, scale=1))\n",
    "\n",
    "# Poisson distribution\n",
    "print(\"Poisson:\", poisson.pmf(2, 3))"
   ]
